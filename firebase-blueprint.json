{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for patients and doctors",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "doctor"] },
        "age": { "type": "string" },
        "gender": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "address": { "type": "string" },
        "degree": { "type": "string" },
        "isSharingEnabled": { "type": "boolean" },
        "onboarded": { "type": "boolean" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "MedicalRecord": {
      "title": "Medical Record",
      "description": "Medical record uploaded by a patient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "fileURL": { "type": "string" },
        "fileName": { "type": "string" },
        "type": { "type": "string", "enum": ["prescription", "report"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "fileURL", "type", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "records/{recordId}": {
      "schema": "MedicalRecord",
      "description": "Medical records repository"
    }
  }
}
